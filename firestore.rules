rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function pairId(a, b) {
      return a < b ? a + '__' + b : b + '__' + a;
    }

    function eitherBlocked(a, b) {
      return exists(/databases/$(database)/documents/user_blocks/$(a)/blocked/$(b))
        || exists(/databases/$(database)/documents/user_blocks/$(b)/blocked/$(a));
    }

    function threadOpen(thread) {
      let participants = thread.participants;
      return participants.size() == 2
        && !eitherBlocked(participants[0], participants[1]);
    }

    // Preserved world-chat contract. Optional fields are validated independently.
    match /world_chat/{message} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.text.matches('.*\\S.*')
        && request.resource.data.admin == (request.auth.token.admin == true)
        && request.auth.token.muted == false
        && request.resource.data.ts == request.time
        && (!('photoUrl' in request.resource.data)
          || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 1000))
        && (!('replyName' in request.resource.data)
          || (request.resource.data.replyName is string && request.resource.data.replyName.size() <= 40))
        && (!('replyText' in request.resource.data)
          || (request.resource.data.replyText is string && request.resource.data.replyText.size() <= 200))
        && (!('replyToId' in request.resource.data)
          || (request.resource.data.replyToId is string && request.resource.data.replyToId.size() <= 100))
        && ((!('replyName' in request.resource.data)
              && !('replyText' in request.resource.data)
              && !('replyToId' in request.resource.data))
          || ('replyName' in request.resource.data && 'replyText' in request.resource.data))
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'ts', 'admin', 'replyName', 'replyText', 'replyToId', 'photoUrl']);
      allow update, delete: if false;
    }

    match /direct_threads/{threadId} {
      // No list rule: cross-document block checks cannot be proven for a query.
      allow get: if signedIn()
        && request.auth.uid in resource.data.participants
        && threadOpen(resource.data);

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0].size() > 0
        && request.resource.data.participants[1].size() > 0
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && threadId == pairId(request.resource.data.participants[0], request.resource.data.participants[1])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 500
        && request.resource.data.lastMessage.matches('.*\\S.*')
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastReadAt is map
        && request.resource.data.lastReadAt.keys().hasOnly([request.auth.uid])
        && request.resource.data.lastReadAt.keys().hasAll([request.auth.uid])
        && request.resource.data.lastReadAt[request.auth.uid] == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['participants', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'lastReadAt', 'createdAt', 'updatedAt'])
        && !eitherBlocked(request.resource.data.participants[0], request.resource.data.participants[1]);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && threadOpen(resource.data)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'updatedAt'])
            && request.resource.data.participants == resource.data.participants
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.lastReadAt == resource.data.lastReadAt
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 500
            && request.resource.data.lastMessage.matches('.*\\S.*')
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.updatedAt == request.time
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt', 'updatedAt'])
            && request.resource.data.lastReadAt.diff(resource.data.lastReadAt).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.lastReadAt[request.auth.uid] is timestamp
            && request.resource.data.updatedAt == request.time
          )
        );

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_threads/$(threadId)).data.participants
          && threadOpen(get(/databases/$(database)/documents/direct_threads/$(threadId)).data);

        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.text.matches('.*\\S.*')
          && request.resource.data.ts == request.time
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'ts'])
          && request.auth.uid in getAfter(/databases/$(database)/documents/direct_threads/$(threadId)).data.participants
          && threadOpen(getAfter(/databases/$(database)/documents/direct_threads/$(threadId)).data);

        allow update, delete: if false;
      }
    }

    // Message-free pointers keep the inbox queryable without weakening thread gets.
    match /user_inboxes/{uid}/threads/{threadId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && getAfter(/databases/$(database)/documents/direct_threads/$(threadId)).data.participants is list
        && request.auth.uid in getAfter(/databases/$(database)/documents/direct_threads/$(threadId)).data.participants
        && uid in getAfter(/databases/$(database)/documents/direct_threads/$(threadId)).data.participants
        && request.resource.data.threadId == threadId
        && request.resource.data.peerId is string
        && request.resource.data.peerId.size() > 0
        && request.resource.data.peerId != uid
        && threadId == pairId(uid, request.resource.data.peerId)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['threadId', 'peerId', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /user_blocks/{blockerId}/blocked/{blockedId} {
      allow read: if signedIn()
        && (request.auth.uid == blockerId || request.auth.uid == blockedId);
      allow create: if signedIn()
        && request.auth.uid == blockerId
        && blockedId != blockerId
        && blockedId is string
        && blockedId.size() > 0
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && request.auth.uid == blockerId;
    }
  }
}
