<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- REQUEST_INSTALL_PACKAGES and the package-archive <queries> entry are
         inherited from src/main and must stay: the Play QA build ships the
         Apps shelf (ENABLE_DOWNLOAD_STORE=true) and installs the APK it just
         downloaded. Removing them broke the Install button — with the query
         gone, Android 11+ package visibility hid the system installer, so
         open_filex hit ActivityNotFoundException ("No APP found to open this
         file") and REQUEST_INSTALL_PACKAGES could never be granted.

         Production Play artifacts declare the permission but never expose an
         APK product, so the Apps shelf stays off there via
         ENABLE_DOWNLOAD_STORE=false. -->

    <!-- Pulled in by open_filex (and file_picker) but never used here: every
         file the app does open lives in its own external-files dir, which
         open_filex opens via FileProvider with no storage permission. Dropping
         them keeps Play's photo/video permission declaration out of the App
         content form. The direct flavor keeps them. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
</manifest>
