<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Play builds may save APKs to public Downloads, but cannot launch the
         package installer. REQUEST_INSTALL_PACKAGES and the installer query
         exist only in src/direct, keeping this artifact policy-compliant.
         Media/storage permissions are removed for both flavors in src/main. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
</manifest>
