<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Play builds intentionally cannot download or install APK products.
         REQUEST_INSTALL_PACKAGES and the package-installer query exist only
         in src/direct, keeping the Play artifact policy-compliant. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!-- Pulled in by open_filex (and file_picker) but never used here: every
         file the app does open lives in its own external-files dir, which
         open_filex opens via FileProvider with no storage permission. Dropping
         them keeps Play's photo/video permission declaration out of the App
         content form. The direct flavor keeps them. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
</manifest>
