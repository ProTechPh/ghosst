<!-- Overrides open_filex's copy (same resource name), which exposed
     external-path and root-path "." — i.e. all of shared storage. The app only
     ever opens <files>/downloads, so only the app's own dirs are shared. -->
<paths>
    <external-files-path
        name="external-files-path"
        path="." />
    <files-path
        name="files-path"
        path="." />
</paths>
